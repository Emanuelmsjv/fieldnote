{
  "name": "fieldnote",
  "version": "0.1.0",
  "private": true,
  "description": "Offline voice field notes for Chidambaram. Transcribes speech on-device with an open-weight Whisper, extracts structured observations, and measures how badly small models mangle regional bird names.",
  "type": "module",
  "license": "CC-BY-NC-SA-4.0",
  "scripts": {
    "pack": "node src/fetch-pack.mjs",
    "setup": "npm run pack",
    "fixtures": "node src/make-fixtures.mjs",
    "fixtures:force": "node src/make-fixtures.mjs --force",
    "test": "node src/test-extract.mjs",
    "eval": "node src/evaluate.mjs --model Xenova/whisper-tiny.en --dtype q8 --out data/eval/tiny-q8.json",
    "eval:base": "node src/evaluate.mjs --model Xenova/whisper-base.en --dtype q8 --out data/eval/base-q8.json",
    "eval:compare": "node src/compare.mjs",
    "note": "node src/note.mjs",
    "report": "node src/note.mjs report"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "onnxruntime-node": "^1.30.0"
  }
}
